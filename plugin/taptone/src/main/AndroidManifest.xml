<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The screen goes off but the CPU has to keep feeding the audio thread. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- How Godot discovers the plugin at startup. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.TapTone"
            android:value="com.addictivexp.taptone.TapTonePlugin" />

        <service
            android:name=".NoiseService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
